	subir = true
end)

up.MouseButton1Up:Connect(function()
	subir = false
end)



down.MouseButton1Down:Connect(function()
	bajar = true
end)

down.MouseButton1Up:Connect(function()
	bajar = false
end)



mas.MouseButton1Click:Connect(function()

	velocidadVuelo += 25

end)



menos.MouseButton1Click:Connect(function()

	velocidadVuelo -= 25

	if velocidadVuelo < 25 then
		velocidadVuelo = 25
	end

end)



crearBoton("✈️ Volar ON/OFF",function()


	volar = not volar


	local char = player.Character

	if not char then return end


	local root = char:FindFirstChild("HumanoidRootPart")

	if not root then return end



	if volar then


		vuelo.Visible = true


		fuerzaVuelo = Instance.new("BodyVelocity")
		fuerzaVuelo.MaxForce = Vector3.new(0,math.huge,0)
		fuerzaVuelo.Parent = root


	else


		vuelo.Visible = false


		if fuerzaVuelo then

			fuerzaVuelo:Destroy()
			fuerzaVuelo = nil

		end


	end


end)



RunService.RenderStepped:Connect(function()

	if volar and fuerzaVuelo then


		if subir then

			fuerzaVuelo.Velocity = Vector3.new(0,velocidadVuelo,0)


		elseif bajar then

			fuerzaVuelo.Velocity = Vector3.new(0,-velocidadVuelo,0)


		else

			fuerzaVuelo.Velocity = Vector3.zero

		end


	end

end)
