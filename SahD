-- INVISIBLE 👻

local transparencias = {}


crearBoton("👻 Invisible",function()

	local char = player.Character

	if not char then return end


	transparencias = {}


	for _,obj in pairs(char:GetDescendants()) do


		if obj:IsA("BasePart") then

			transparencias[obj] = obj.Transparency

			obj.Transparency = 1


		elseif obj:IsA("Decal") then

			transparencias[obj] = obj.Transparency

			obj.Transparency = 1

		end


	end

end)



-- VISIBLE 👤

crearBoton("👤 Visible",function()

	for obj,valor in pairs(transparencias) do

		if obj and obj.Parent then

			obj.Transparency = valor

		end

	end

end)



